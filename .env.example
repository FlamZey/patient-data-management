# Copy this file to .env and adjust values as needed.
# .env itself is gitignored -- never commit real secrets.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb

# Used by the backend container to reach Postgres
DATABASE_URL=postgresql://user:password@db:5432/appdb

# JWT / auth (backend)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level PHI encryption (backend). JSON object mapping key version -> base64
# 32-byte key. Generate new keys with backend/scripts/generate_encryption_key.py.
# Keep old versions here after rotating so previously encrypted data stays readable.
PATIENT_ENCRYPTION_KEYS={"1": "change-me-run-generate_encryption_key.py"}
PATIENT_ENCRYPTION_ACTIVE_VERSION=1

# Used by the frontend (browser-exposed, must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000
